{
  "name": "pyliner-vscode",
  "displayName": "Pyliner",
  "description": "Animated Pyliner lines in a dedicated VS Code Explorer view.",
  "version": "0.1.5",
  "publisher": "pyliner",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:pyliner.sidebar",
    "onCommand:pyliner.showPanel",
    "onCommand:pyliner.addLine",
    "onCommand:pyliner.removeLine",
    "onCommand:pyliner.speedUp",
    "onCommand:pyliner.speedDown"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "pyliner.sidebar",
          "name": "Pyliner",
          "icon": "media/pyliner.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "pyliner.showPanel",
        "title": "Pyliner: Show Panel"
      },
      {
        "command": "pyliner.addLine",
        "title": "Pyliner: Add Line",
        "icon": "$(add)"
      },
      {
        "command": "pyliner.removeLine",
        "title": "Pyliner: Remove Line",
        "icon": "$(remove)"
      },
      {
        "command": "pyliner.speedUp",
        "title": "Pyliner: Speed Up",
        "icon": "$(chevron-up)"
      },
      {
        "command": "pyliner.speedDown",
        "title": "Pyliner: Speed Down",
        "icon": "$(chevron-down)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pyliner.showPanel"
        },
        {
          "command": "pyliner.addLine"
        },
        {
          "command": "pyliner.removeLine"
        },
        {
          "command": "pyliner.speedUp"
        },
        {
          "command": "pyliner.speedDown"
        }
      ],
      "view/title": [
        {
          "command": "pyliner.removeLine",
          "when": "view == pyliner.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "pyliner.addLine",
          "when": "view == pyliner.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "pyliner.speedDown",
          "when": "view == pyliner.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "pyliner.speedUp",
          "when": "view == pyliner.sidebar",
          "group": "navigation@4"
        }
      ]
    }
  }
}
