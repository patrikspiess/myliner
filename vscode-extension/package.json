{
  "name": "myliner-vscode",
  "displayName": "Myliner",
  "description": "Animated Myliner lines in a dedicated VS Code Explorer view.",
  "version": "0.1.5",
  "publisher": "myliner",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:myliner.sidebar",
    "onCommand:myliner.showPanel",
    "onCommand:myliner.addLine",
    "onCommand:myliner.removeLine",
    "onCommand:myliner.speedUp",
    "onCommand:myliner.speedDown"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "myliner.sidebar",
          "name": "Myliner",
          "icon": "media/myliner.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "myliner.showPanel",
        "title": "Myliner: Show Panel"
      },
      {
        "command": "myliner.addLine",
        "title": "Myliner: Add Line",
        "icon": "$(add)"
      },
      {
        "command": "myliner.removeLine",
        "title": "Myliner: Remove Line",
        "icon": "$(remove)"
      },
      {
        "command": "myliner.speedUp",
        "title": "Myliner: Speed Up",
        "icon": "$(chevron-up)"
      },
      {
        "command": "myliner.speedDown",
        "title": "Myliner: Speed Down",
        "icon": "$(chevron-down)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "myliner.showPanel"
        },
        {
          "command": "myliner.addLine"
        },
        {
          "command": "myliner.removeLine"
        },
        {
          "command": "myliner.speedUp"
        },
        {
          "command": "myliner.speedDown"
        }
      ],
      "view/title": [
        {
          "command": "myliner.removeLine",
          "when": "view == myliner.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "myliner.addLine",
          "when": "view == myliner.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "myliner.speedDown",
          "when": "view == myliner.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "myliner.speedUp",
          "when": "view == myliner.sidebar",
          "group": "navigation@4"
        }
      ]
    }
  }
}
